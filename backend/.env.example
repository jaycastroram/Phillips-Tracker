# Copy to backend/.env and fill in real values.
# backend/.env is gitignored.

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Zoho Analytics (Self Client OAuth) ---
# 1) Create a Self Client at https://api-console.zoho.com/
# 2) Generate a refresh token with Zoho Analytics scopes
# 3) Match accounts + analytics URLs to your data center
ZOHO_ANALYTICS_CLIENT_ID=
ZOHO_ANALYTICS_CLIENT_SECRET=
ZOHO_ANALYTICS_REFRESH_TOKEN=
ZOHO_ANALYTICS_ORG_ID=
ZOHO_ANALYTICS_WORKSPACE_ID=

# US defaults — change for EU/IN/AU/etc.
ZOHO_ACCOUNTS_SERVER_URL=https://accounts.zoho.com
ZOHO_ANALYTICS_SERVER_URL=https://analyticsapi.zoho.com

# --- NetSuite catalog sync (read-only SuiteQL, token-based auth) ---
# One company per run; the nightly cron passes the same value.
NETSUITE_SYNC_COMPANY_SLUG=
NETSUITE_CONSUMER_KEY=
NETSUITE_CONSUMER_SECRET=
NETSUITE_TOKEN_ID=
NETSUITE_TOKEN_SECRET=
NETSUITE_REALM=
# The account's REST base, no trailing slash, no quotes.
NETSUITE_BASE_URL=
